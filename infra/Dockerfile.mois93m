# Minimal long-lived MOIS 93m photo worker, suitable for a user-owned
# near-source VM/container after explicit compute/budget and source access setup.
# This image does not include photos, detector weights, AWS credentials or results.
# Building it alone launches no photo download or inference.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    ULTRALYTICS_OFFLINE=True
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir \
      "numpy==2.1.3" "Pillow==11.3.0" \
      "ultralytics==8.4.112" "urllib3==2.5.0"
WORKDIR /opt/mois
COPY scripts /opt/mois/scripts
# Source and photo results come from mounted volumes. No licensed image files
# are embedded in the container image; ephemeral fetched pixels remain in RAM.
RUN useradd --create-home --uid 10001 mois
USER mois
ENTRYPOINT ["python","-m","scripts.acquisition.mois_93m_persistent_worker"]
