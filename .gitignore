# Original source-photo and WorldClim/SoilGrids archives need permission review;
# never accidentally commit original full ZIPs to the research repository.
raw_inputs/
*.partial
# CI-only numerical audit bundles; not a permanent journal repository.
dist/

# Never commit private iNaturalist photo/observer/geoprivacy crosswalks or local
# third-party WorldClim GeoTIFF bytes created during seasonal research.
.trusted/
restricted/
private_inputs/
private_outputs/
*.INCOMPLETE/
